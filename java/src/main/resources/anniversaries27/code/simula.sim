COMMENT SIMULA I - ALGOL 60 with processes ;
SIMULA BEGIN
   ACTIVITY Institute(Founded);
      INTEGER Founded;
   BEGIN
      PROCEDURE Describe;
      BEGIN
         OUTTEXT("Programming language SIMULA");
         OUTTEXT(" was developed at the Norwegian");
         OUTTEXT(" Computing Center in Oslo");
         OUTIMAGE
      END;

      HOLD(Founded);
      Describe
   END;

   ELEMENT NCC;
   NCC := NEW Institute(1962);
   ACTIVATE NCC;
   HOLD(1963)
END
